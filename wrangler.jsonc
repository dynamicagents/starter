/**
 * One Worker, every agent in it.
 *
 * The agents are **tenants** of one deployment, routed by `src/index.ts` on the
 * A2A `params.tenant` — they share one origin, one `/a2a` endpoint, one signed
 * AgentCard, one JWKS and one signing key. What they do *not* share is what is
 * configured below: each gets its own Durable Object class. Blocks are grouped
 * per agent so deleting one is a comment-out rather
 * than a puzzle — see "Delete what you don't want" in the README for the full
 * three-step removal.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "da-starter",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  // The deployment's public origin, and the only one.
  //
  // Declared here rather than attached in the dashboard because a deploy that
  // does not own its own hostname is a deploy that can silently land nowhere:
  // rename the Worker and the domain keeps serving the script it was attached
  // to, so the new one is live, healthy, and reachable by nobody.
  //
  // `workers_dev` is off, and that is a correctness constraint rather than
  // tidiness. Core derives the card's interface URL, its `jku` and the token
  // audience it verifies from `new URL(request.url).origin` — see
  // `src/index.ts`. A second origin therefore advertises a second audience, and
  // a gatekeeper token minted for this one does not verify against it. It could
  // only ever serve a card nobody can call.
  "workers_dev": false,
  "routes": [{ "pattern": "agents.loopingai.org", "custom_domain": true }],
  // Headroom for git, which now runs here rather than in the container.
  //
  // `@cloudflare/computer/git` is isomorphic-git: SHA-1 and inflate in
  // JavaScript, on this Worker's CPU budget rather than a container's. Measured
  // before setting this, shallow and single-branch — a 485-file repository
  // clones in ~1.1 s and a 5,456-file monorepo in ~5.5 s wall-clock, most of it
  // network — so the default 30 s is not close to binding. This is for the
  // repository that is an order of magnitude past those, not for the ones that
  // were measured; a clone that dies at 30 s costs a whole task.
  "limits": { "cpu_ms": 300000 },
  "observability": {
    "enabled": true,
    // Traces, not just logs. Every workspace passes
    // `createCloudflareObserver({ tracing })` to its `Workspace`, which emits a
    // span per sync push, sync pull, exec spawn and filesystem operation — and
    // the sync telemetry alongside it reports what each block of a pull cost.
    // Those are the only view into how long a container→host sync actually
    // takes, and without this flag `tracing` is undefined and the observer
    // silently degrades to a no-op.
    "traces": {
      "enabled": true
    }
  },

  // No `vars` and no model credential anywhere in this file — every agent reaches
  // Workers AI through the `AI` binding below, which the platform authenticates.
  // See the secrets block at the bottom for what remains and what was removed.

  // --- shared: required by core itself -------------------------------------

  // Workers AI backs every agent's model (via AI Gateway). `remote: true`
  // reflects reality — Workers AI has no local execution mode and always hits
  // remote resources — and suppresses wrangler's per-run warning. In tests the
  // pool-level `remoteBindings: false` (vitest.config.ts) overrides this and
  // keeps the suite from eagerly opening that remote connection.
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // --- plugin-required bindings --------------------------------------------
  // A plugin cannot add its own wrangler binding, which is the whole reason it
  // declares `requires`. Each of these is asserted when the agent starts, so a
  // missing one fails with a sentence naming the plugin rather than at the first
  // tool call, inside a request someone is waiting on.

  // Each coder's workspace container, running `computerd` (see Dockerfile).
  // Requires a PAID Workers plan.
  //
  // `class_name` is the Durable Object that *owns* the container, one-to-one:
  // `@cloudflare/computer` pairs each object's SQLite filesystem with exactly
  // one container, which is what makes "one workspace per repository" a
  // structural property rather than a convention.
  //
  // **The object starts its own container** (`scheduling_policy`), from the
  // image under `images.app` and at the size its workspace config passes:
  // `WORKSPACE_INSTANCE` and `CLAUDE_COORDINATOR_WORKSPACE_INSTANCE` in
  // `src/config.ts`, which say why. The policy is fixed when
  // an application is created: one made under another policy is deleted before
  // the deploy that moves it, never switched. `@dynamicagents/plugins/workspace`
  // carries how, and what the gap between the two costs.
  //
  // **One Dockerfile, an image per entry.** Cloudflare builds each entry's
  // `images` on its own, so every entry naming this Dockerfile gets an image of
  // its own — and `build_vars` is a Docker build arg, which is how
  // `claude-coordinator`'s image gets the Claude Code CLI and `coding`'s does not.
  //
  // **Nothing here caps how many run.** Running containers count against the
  // account's limits rather than a ceiling per entry, and for `claude-coordinator`
  // that is what bounds the fan-out: a writing or planning session works in a
  // worktree of its own while the parent keeps one, so N sessions at once want N+1
  // instances of `ClaudeCoordinatorWorkspace` — `CLAUDE_COORDINATOR` in
  // `src/config.ts` carries why. A full fan-out plus its parent, three times over,
  // is around 2% of the concurrent vCPU Cloudflare documents per account, and 1.5%
  // of the memory — both scale with `CLAUDE_COORDINATOR_WORKSPACE_INSTANCE`, so
  // resizing it moves them. What the width costs is the bill, because memory and disk are billed
  // on provisioned resources for as long as an instance runs — the same reason a
  // settled task stops its container rather than waiting out the idle deadline.
  // `npm run cf -- containers` is where to watch it.
  //
  // **A deploy with a new image replaces each running container** when its
  // workspace next connects, so there is no rollout to stage: the library in the
  // Worker and the `computerd` in the image are one release, and `backend` in
  // `@dynamicagents/plugins/workspace` carries why that has to hold.
  //
  // `observability` is per entry and not inherited from the Worker's — omitted,
  // an application keeps whatever it had. It is what carries `computerd`'s own
  // output, including whether it mounted over FUSE or fell back to the shim.
  "containers": [
    {
      "class_name": "CodingWorkspace",
      "scheduling_policy": "durable_object",
      "images": { "app": { "dockerfile": "./Dockerfile" } },
      "observability": { "logs": { "enabled": true } }
    },
    {
      "class_name": "ClaudeCoordinatorWorkspace",
      "scheduling_policy": "durable_object",
      "images": {
        "app": {
          "dockerfile": "./Dockerfile",
          // **Pinned to the version the claude-code plugin verified**, and
          // `npm run check` fails when the two differ — the Dockerfile carries
          // why. `gh` is unauthenticated and can only read public repositories —
          // the Dockerfile block carries why, and why it still needs a GH_TOKEN.
          // The checksum is pinned because the build downloads the tarball.
          "build_vars": {
            "CLAUDE_CODE_VERSION": "2.1.289",
            "GH_VERSION": "2.101.0",
            "GH_SHA256": "9bca2d1c16825f109907a23307628a2f0698fbf99662b73a5cf0b020293072b8"
          }
        }
      },
      "observability": { "logs": { "enabled": true } }
    }
  ],

  // There is deliberately **no R2 bucket here**, and it is worth saying why,
  // because a `BACKUP_BUCKET` binding looks like an obvious thing to add.
  //
  // The coding agent used to snapshot its container's `/workspace` to R2 between tasks
  // so a follow-up skipped the clone and the install. It never worked once in
  // production: `@cloudflare/sandbox` mounts that archive **inside the
  // container** over s3fs, so it needs R2 S3-API credentials
  // (`R2_ACCESS_KEY_ID` and friends) that a Workers R2 binding cannot supply —
  // the binding has no presign API. Every task logged `InvalidBackupConfigError`.
  //
  // Nothing replaces it for the checkout: it now lives in the workspace object's
  // own SQLite storage, which survives the container and costs no credential at
  // all. Dependencies live on the container's disk, and a new container starts
  // from a Containers snapshot of the one that installed them — a platform
  // feature, not a bucket. See `src/workspace/install-plan.ts`.

  // `@dynamicagents/plugins/browser` — used by every agent.
  // NOTE: requires a PAID Workers plan; Browser Rendering is not on the free
  // tier. `remote: true` is required for Quick Actions under `wrangler dev`.
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },

  // --- the agents ----------------------------------------------------------
  // Each tenant's task host, which holds a caller's A2A tasks, and the step
  // agent its pipeline runs on, which holds its SQLite-backed Session —
  // continuous history plus writable memory. Both are keyed by the verified
  // caller (`identity.key`). A host's binding is named as its class:
  // `hostBinding` names it, and a workflow reaches the host through it.
  //
  // The sub-agent classes (`GenericChild` and its siblings) are deliberately
  // absent. Each is a facet created beneath its agent, so it needs no binding and
  // no `new_sqlite_classes` entry; it only has to be exported from src/index.ts
  // so `ctx.exports` can resolve it by class name. They DO need a test-only
  // binding — see the comment in vitest.config.ts.
  "durable_objects": {
    "bindings": [
      { "class_name": "GenericHost", "name": "GenericHost" },
      { "class_name": "GenericAgent", "name": "GenericAgent" },
      { "class_name": "CodingHost", "name": "CodingHost" },
      { "class_name": "CodingAgent", "name": "CodingAgent" },
      {
        "class_name": "ClaudeCoordinatorHost",
        "name": "ClaudeCoordinatorHost"
      },
      {
        "class_name": "ClaudeCoordinatorAgent",
        "name": "ClaudeCoordinatorAgent"
      },

      // Not agents — the workspaces. One object per caller per repository,
      // holding that checkout's filesystem in SQLite and owning the container
      // that mounts it. Addressed by `idFromName`, never by the caller alone;
      // see `workspaceName` in `@dynamicagents/plugins/workspace`, which
      // both share.
      //
      // Two classes rather than one shared class with two bindings, because a
      // Durable Object namespace is keyed by class name: one class would put
      // both agents' checkouts in one namespace, and a caller working on the
      // same repository through both would get one container for both.
      { "class_name": "CodingWorkspace", "name": "CODING_WORKSPACE" },
      {
        "class_name": "ClaudeCoordinatorWorkspace",
        "name": "CLAUDE_COORDINATOR_WORKSPACE"
      },

      // Not an agent, and not optional. Core files every sub-agent note on the
      // Task's transcript and posts a link instead of the note, so an agent
      // Durable Object that starts without this binding throws at `onStart` —
      // core's `@dynamicagents/core/artifacts` owns the reasoning and the
      // error names the lines. The class is core's own, re-exported unchanged
      // from src/index.ts, and one object serves the whole deployment: a
      // reader arrives holding a token and nothing else, so the object it
      // reaches cannot be keyed by task.
      //
      // Binding it is half the wiring. The links are served by the delegation
      // at the top of `fetch` in src/index.ts, and without that one an
      // artifact URL falls through to routes that know nothing about it.
      { "class_name": "Artifacts", "name": "ARTIFACTS" }
    ]
  },
  // **A tag is applied once, ever.** Anything appended to a tag you have already
  // deployed is simply never applied: a new class is never created, and the
  // failure surfaces far from this file — at the first request to the agent, or
  // at deploy with "New version of script does not export class 'X' which is
  // depended on by existing Durable Objects". Always add a new tag.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReactiveAgent",
        "ProactiveAgent",
        "ArcPlayerAgent"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["CoderAgent", "Sandbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CoderWorkspaceDO"]
    },
    {
      // Removing a class from the code reclaims nothing on its own: every object
      // it created keeps its storage, unreachable and still billed. This is the
      // line that frees them, and it is irreversible.
      "tag": "v4",
      "deleted_classes": ["Sandbox"]
    },
    {
      // Both classes in one tag because they arrive together: the agent and the
      // workspace it owns.
      "tag": "v5",
      "new_sqlite_classes": ["ClaudeCoderAgent", "ClaudeCoderWorkspaceDO"]
    },
    {
      // Core's class rather than one of ours, and it still needs a tag here:
      // a migration is a property of the deployment that binds the class, not
      // of the package that wrote it.
      "tag": "v6",
      "new_sqlite_classes": ["Artifacts"]
    },
    {
      // The `cf-coder` agent and its workspace start empty: `deleted_classes`
      // drops every object the deleted pair stored, sessions and checkouts alike.
      "tag": "v7",
      "new_sqlite_classes": ["CfCoderAgent", "CfCoderWorkspaceDO"],
      "deleted_classes": ["CoderAgent", "CoderWorkspaceDO"]
    },
    {
      // The arc-player agent's objects, and the facets beneath them. See v4 for
      // why the class leaving the code is not enough.
      "tag": "v8",
      "deleted_classes": ["ArcPlayerAgent"]
    },
    {
      // The proactive agent's objects. See v4 for why the class leaving the
      // code is not enough.
      "tag": "v9",
      "deleted_classes": ["ProactiveAgent"]
    },
    {
      // The agents move onto Think under new class names, and start empty:
      // every task, conversation and memory the old classes held is dropped.
      // The workspace objects are untouched, so every checkout survives.
      "tag": "v10",
      "deleted_classes": ["ReactiveAgent", "CfCoderAgent", "ClaudeCoderAgent"],
      "new_sqlite_classes": ["Reactive", "CfCoder", "ClaudeCoder"]
    },
    {
      // Each tenant becomes a task host, a pipeline and a step agent, under a
      // name for what it does, and starts empty with its workspace: every task,
      // conversation, memory and checkout the old classes held is dropped.
      // `deleted_classes` names each class as it is deployed, which is what a
      // deletion is matched on.
      "tag": "v11",
      "deleted_classes": [
        "Reactive",
        "CfCoder",
        "CfCoderWorkspaceDO",
        "ClaudeCoder",
        "ClaudeCoderWorkspaceDO"
      ],
      "new_sqlite_classes": [
        "GenericHost",
        "GenericAgent",
        "CodingHost",
        "CodingAgent",
        "CodingWorkspace",
        "AnthropicCodingHost",
        "AnthropicCodingAgent",
        "AnthropicCodingWorkspace"
      ]
    },
    {
      // `anthropic-coding` becomes `claude-coordinator`, under classes no
      // deployment has used, and starts empty: every task, plan, memory and
      // worktree the old classes held is dropped, unpushed branches included.
      "tag": "v12",
      "deleted_classes": [
        "AnthropicCodingHost",
        "AnthropicCodingAgent",
        "AnthropicCodingWorkspace"
      ],
      "new_sqlite_classes": [
        "ClaudeCoordinatorHost",
        "ClaudeCoordinatorAgent",
        "ClaudeCoordinatorWorkspace"
      ]
    }
  ],

  // --- workflows --------------------------------------------------------------
  // Each tenant's pipeline: every task is an instance, its id the task's. The
  // names differ from the pre-Think Workflows (`handle-task`, `cf-coder`,
  // `claude-coder`), which the cutover deletes once this deploys: a name reused
  // would be deleted with them.
  "workflows": [
    {
      "name": "generic-workflow",
      "binding": "GENERIC_WORKFLOW",
      "class_name": "GenericWorkflow"
    },
    {
      "name": "coding-workflow",
      "binding": "CODING_WORKFLOW",
      "class_name": "CodingWorkflow"
    },
    {
      "name": "claude-coordinator-workflow",
      "binding": "CLAUDE_COORDINATOR_WORKFLOW",
      "class_name": "ClaudeCoordinatorWorkflow"
    }
  ],

  // --- secrets --------------------------------------------------------------
  // What each of these is, and why there is one signing key rather than one per
  // agent, is in `.env.example` — the file an operator fills in. Declared here
  // because `secrets.required` is what drives type generation and `wrangler
  // dev`'s missing-secret warnings.
  //
  // **There is no model credential here, for any agent.** Every agent in this
  // Worker reaches Workers AI through the `AI` binding above, which Cloudflare
  // authenticates for the Worker — there is no key to store, rotate or leak, and
  // no AI Gateway token either. See `.env.example`.
  "secrets": {
    "required": [
      "A2A_SIGNING_KEY",
      "GATEKEEPER_ORIGINS",
      // Both coders. `GITHUB_TOKEN` needs contents and pull-request write.
      //
      // It is read exclusively inside a workspace object, never crosses an RPC
      // argument, and never enters the container — `onAuth` checks the host
      // allowlist at the moment the token is handed over.
      "GITHUB_TOKEN",
      // The git identity behind those commits — same requirement as
      // GITHUB_TOKEN above. See `.env.example` for what each configures.
      "GITHUB_NAME",
      "GITHUB_EMAIL",

      // `claude-coordinator` only, and a credential pool rather than a secret — see
      // `.env.example`, which is where an operator sets them, for how rotation
      // works and why none of them ever enters the container.
      //
      // **Every credential this deployment has is listed here.**
      // `secrets.required` drives type generation and `wrangler dev`'s
      // missing-secret warnings, so a name left here and unset is typed as a
      // definite string that is undefined at runtime and warns on every local
      // run. Adding or dropping one is the same edit in this list *and* in the
      // pool in `src/agents/claude-coordinator/claude-code.ts`.
      "CLAUDE_CODE_OAUTH_TOKEN_1",
      "CLAUDE_CODE_OAUTH_TOKEN_2",
      "CLAUDE_CODE_OAUTH_TOKEN_3"
    ]
  }
}
